ANTHROPIC_API_KEY=sk-ant-xxxxx
MODEL=claude-sonnet-5
PORT=3000
# 走中转站才需要填这个,直连官方 API 留空即可
ANTHROPIC_BASE_URL=

# 整站密码锁:填了这个,打开网站就会先要求输入这个密码才能进(密码存在浏览器
# cookie 里,登录一次一年内不用重复输入)。不填就完全不启用锁,跟以前一样直接进。
SITE_PASSWORD=

# ElevenLabs TTS(配了这个就优先用它,优先级比 MiniMax 高)
# 官方直连地址,一般不用改;key 和 voice id 在 elevenlabs.io 后台拿
ELEVENLABS_API_HOST=https://api.elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# 必须是 eleven_v3 才认识 [breathing heavily] [whispers] 这类方括号表演标签,
# 换成 v2 系列这些标签就只会被当成普通文字或者忽略掉
ELEVENLABS_MODEL=eleven_v3
# 下面四个是"活人感"的关键旋钮,数值越极端表现力越强、但一致性越差:
# stability 越低越有起伏(太高会念得很平);style 越高越有戏;speed 略快于 1 更像真人语速
ELEVENLABS_STABILITY=0.3
ELEVENLABS_SIMILARITY=0.75
ELEVENLABS_STYLE=0.88
ELEVENLABS_SPEED=1.08

# MiniMax speech-02 TTS(ElevenLabs 和 MiniMax 都没配就自动退回浏览器自带朗读)
# 国际版填 https://api.minimax.io,国内版填 https://api.minimaxi.com
MINIMAX_API_HOST=https://api.minimax.io
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_VOICE_ID=
# speech-02-turbo 延迟低适合实时通话,speech-02-hd 音质更好但慢一些
MINIMAX_MODEL=speech-02-turbo
# 语气情绪,可选 happy/sad/angry/fearful/disgusted/surprised/neutral,默认 happy(比默认平淡的音色更有起伏)
MINIMAX_EMOTION=happy
# /clone.html 上传克隆页面的口令,不填就不校验(不建议留空,毕竟克隆要花钱)
CLONE_PASSCODE=

# Supabase(聊天记录持久化 + 多会话 + 记忆压缩,不填就不能用这些功能)
# 在 Supabase 项目里跑一遍 supabase-schema.sql 建表,Settings -> API 里拿这两个值
SUPABASE_URL=
SUPABASE_KEY=
# 可选:配了就用 DeepSeek 做记忆压缩(更便宜),不配就用主模型自己压缩
DEEPSEEK_API_KEY=
# 可见消息总字数超过这个阈值才触发压缩(调太低会导致细节被压没,聊几句就"变笨")
COMPRESS_CHAR_THRESHOLD=14000
# 压缩时至少保留最近这么多条消息不压
COMPRESS_KEEP_MESSAGES=20
# 压缩出来的"记忆"本身也会越攒越多(每压缩一轮就多一条,全部都会拼进每次的
# 提示词里),攒到这个字数就会把已有的记忆再合并成一条,让记忆库本身有上限,
# 不会陪着对话一直无限变大
MEMORY_CONSOLIDATE_THRESHOLD=6000
