ANTHROPIC_API_KEY=sk-ant-xxxxx
MODEL=claude-sonnet-5
PORT=3000
# 走中转站才需要填这个,直连官方 API 留空即可
ANTHROPIC_BASE_URL=

# MiniMax speech-02 TTS(不填就自动退回浏览器自带朗读)
# 国际版填 https://api.minimax.io,国内版填 https://api.minimaxi.com
MINIMAX_API_HOST=https://api.minimax.io
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_VOICE_ID=
# speech-02-turbo 延迟低适合实时通话,speech-02-hd 音质更好但慢一些
MINIMAX_MODEL=speech-02-turbo
# 语气情绪,可选 happy/sad/angry/fearful/disgusted/surprised/neutral,默认 happy(比默认平淡的音色更有起伏)
MINIMAX_EMOTION=happy
# /clone.html 上传克隆页面的口令,不填就不校验(不建议留空,毕竟克隆要花钱)
CLONE_PASSCODE=
